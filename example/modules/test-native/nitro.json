{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["callstack", "testnative"],
  "ios": { "iosModuleName": "TestNative" },
  "android": {
    "androidNamespace": ["callstack", "testnative"],
    "androidCxxLibName": "TestNative"
  },
  "autolinking": {
    "TestNative": {
      "ios": { "language": "swift", "implementationClassName": "HybridTestNative" },
      "android": { "language": "kotlin", "implementationClassName": "HybridTestNative" }
    }
  },
  "ignorePaths": ["node_modules"]
}
