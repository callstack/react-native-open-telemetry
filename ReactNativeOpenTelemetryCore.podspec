require "json"

package = JSON.parse(File.read(File.join(__dir__, "package.json")))

# `telemetry.distro.version` from package.json, written at `pod install` (git-ignored), as Android's Gradle reads it.
File.write(File.join(__dir__, "ios/RNOtel/PackageVersion.swift"),
           "// Generated by ReactNativeOpenTelemetryCore.podspec from package.json.\nlet packageVersion = \"#{package["version"]}\"\n")

# Pure Swift (R24): the core and the public `RNOtel` API, no Nitro and no C++ interop, so an app's Swift
# `AppDelegate` can `import ReactNativeOpenTelemetryCore`. The Nitro adapter pod (ReactNativeOpenTelemetry) depends on it.
# Autolinking links one podspec per package: apps add `pod 'ReactNativeOpenTelemetryCore', :path => '<package dir>'`.
Pod::Spec.new do |s|
  s.name         = "ReactNativeOpenTelemetryCore"
  s.version      = package["version"]
  s.summary      = package["description"]
  s.homepage     = package["homepage"]
  s.license      = package["license"]
  s.authors      = package["author"]

  s.platforms    = { :ios => min_ios_version_supported }
  s.source       = { :git => "https://github.com/callstack/react-native-open-telemetry.git", :tag => "#{s.version}" }
  s.swift_version = "5.0"

  s.source_files = ["ios/Core/**/*.swift", "ios/RNOtel/**/*.swift"]

  # `package` declarations are shared with the adapter pod through one Swift package name.
  # Test mode is a build flag, never API: `OTEL_TEST_MODE=1 pod install`.
  s.pod_target_xcconfig = {
    'OTHER_SWIFT_FLAGS' => '$(inherited) -package-name ReactNativeOpenTelemetry',
  }.merge(ENV['OTEL_TEST_MODE'] == '1' ? { 'SWIFT_ACTIVE_COMPILATION_CONDITIONS' => '$(inherited) OTEL_TEST_MODE' } : {})

  # opentelemetry-swift 2.6 moved OpenTelemetryApi/OpenTelemetrySdk into opentelemetry-swift-core.
  spm_dependency(s,
    url: 'https://github.com/open-telemetry/opentelemetry-swift',
    requirement: { kind: 'upToNextMinorVersion', minimumVersion: '2.6.0' },
    products: ['OpenTelemetryProtocolExporterHTTP'])
  spm_dependency(s,
    url: 'https://github.com/open-telemetry/opentelemetry-swift-core',
    requirement: { kind: 'upToNextMinorVersion', minimumVersion: '2.6.0' },
    products: ['OpenTelemetrySdk'])
end
