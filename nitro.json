{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["callstack", "otel"],
  "ios": { "iosModuleName": "ReactNativeOpenTelemetry" },
  "android": {
    "androidNamespace": ["callstack", "otel"],
    "androidCxxLibName": "ReactNativeOpenTelemetry"
  },
  "autolinking": {
    "Otel": {
      "ios": { "language": "swift", "implementationClassName": "HybridOtel" },
      "android": { "language": "kotlin", "implementationClassName": "HybridOtel" }
    }
  },
  "ignorePaths": ["node_modules", "example", "example-expo", "verify"]
}
